# ---------------------------------------------------------------------------
# Job Finder — configuration locale
# Copier ce fichier vers .env puis remplir les valeurs.
#   cp .env.example .env
# Le fichier .env n'est jamais versionné.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000

# Origines autorisées pour le front (séparées par des virgules).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OpenCode Go (OpenAI-compatible) ---------------------------------------
# URL de base de l'API OpenCode Go, sans slash final.
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Clé API personnelle (Console OpenCode > Go). Ne jamais committer ce fichier.
OPENCODE_API_KEY=

# Modèle utilisé pour noter les offres (rapide et économique).
SCORING_MODEL=deepseek-v4.1-flash
# Modèle utilisé pour rédiger les lettres de motivation (meilleure qualité).
LETTER_MODEL=claude-haiku-5-5

# --- LLM runtime ------------------------------------------------------------
# opencode_go = vrais appels ; mock = réponses simulées, sans clé ni réseau.
LLM_PROVIDER=opencode_go
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE_LETTER=0.3
# Identifiant de session stable envoyé au fournisseur (routage et cache).
LLM_SESSION_ID=job-finder-local

# --- Limites ----------------------------------------------------------------
MAX_UPLOAD_MB=10
# Nombre maximum d'offres envoyées au LLM par scan (garde-fou budgétaire).
MAX_SCORING_PER_SCAN=150

# --- Stockage ---------------------------------------------------------------
# Laisser vide pour utiliser backend/instance/job_finder.db et backend/uploads.
DATABASE_URL=
UPLOAD_DIR=
